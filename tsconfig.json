{
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "target": "es2024",
        "module": "node20",
        "moduleResolution": "node16",
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,

        "rootDir": "src",
        "baseUrl": "src",

        "paths": {
            "@tokenizers/*": [ "./tokenizers/*" ],
            "@lib/*": [ "./lib/*" ]
        }
    }
}